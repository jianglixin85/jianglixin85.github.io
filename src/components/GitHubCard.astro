---
interface Props {
  title: string;
  description: string;
  language?: string;
  stars: number;
  url: string;
  updated: string;
}

const { title, description, language, stars, url, updated } = Astro.props;

const timeAgo = (dateStr: string) => {
  const diff = Date.now() - new Date(dateStr).getTime();
  const days = Math.floor(diff / 86400000);
  if (days < 1) return '今天';
  if (days < 30) return `${days} 天前`;
  if (days < 365) return `${Math.floor(days / 30)} 个月前`;
  return `${Math.floor(days / 365)} 年前`;
};
---

<a href={url} target="_blank" rel="noopener" class="card block p-5 no-underline">
  <div class="mb-2 flex items-start justify-between gap-2">
    <h3 class="text-base font-semibold text-text">{title}</h3>
    <span class="tag shrink-0">GitHub</span>
  </div>
  <p class="mb-3 text-sm leading-relaxed text-text-soft line-clamp-2">{description || '暂无描述'}</p>
  <div class="flex items-center gap-3 text-xs text-text-muted">
    {language && (
      <span class="flex items-center gap-1">
        <span class="inline-block h-2 w-2 rounded-full" style="background: var(--color-accent);"></span>
        {language}
      </span>
    )}
    <span class="flex items-center gap-1">
      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
      </svg>
      {stars}
    </span>
    <span>{timeAgo(updated)}</span>
  </div>
</a>
