---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GitHubCard from '../components/GitHubCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { getCollection } from 'astro:content';
import profile from '../data/profile';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

let projectsGitHub: Awaited<ReturnType<typeof getCollection<'projectsGitHub'>>> = [];
try { projectsGitHub = await getCollection('projectsGitHub'); } catch {}
const ghProjects = projectsGitHub
  .sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime())
  .slice(0, 2);

const notesLocal = await getCollection('notes');
let notesFeishu: typeof notesLocal = [];
try { notesFeishu = await getCollection('notesFeishu'); } catch {}

const allFeishuNotes = notesFeishu
  .filter((n) => !n.data.draft);

// Group feishu notes by category tag
const feishuCategories = profile.noteCategories.map((cat) => ({
  ...cat,
  notes: allFeishuNotes
    .filter((n) => n.data.tags.includes(cat.tag))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map((n) => ({ ...n, source: 'feishu' as const })),
}));
---

<Base title="蒋立鑫 | 个人主页">
  <div class="mx-auto max-w-page px-4 py-12 md:px-6 md:py-16">
    <!-- Hero -->
    <section class="mb-12 card hero-card p-6 md:p-8">
      <div class="flex flex-col items-center gap-6 md:flex-row md:items-start md:gap-8">
        <div class="shrink-0">
          <img
            src={profile.hero.avatar}
            alt={profile.hero.name}
            class="h-28 w-28 rounded-full object-cover md:h-36 md:w-36"
            style="box-shadow: 0 0 0 3px var(--color-accent-bg), var(--shadow-card);"
          />
        </div>
        <div>
          <h1 class="text-h1 mb-3">{profile.hero.name}</h1>
          <p class="max-w-prose text-lg leading-relaxed text-text-soft">
            {profile.hero.bio}
          </p>
        </div>
      </div>
    </section>

    <!-- AI学习笔记 (Feishu Wiki) -->
    <section class="mb-10">
      <h2 class="sec-title">AI学习笔记</h2>
      <p class="mb-6 text-sm text-text-soft">来自飞书知识库，持续更新的 AI 学习笔记</p>
      {feishuCategories.map((cat) => (
        <div class="mb-6">
          <h3 class="mb-3 text-h4 font-medium text-text">
            <a href={`/notes?tag=${encodeURIComponent(cat.tag)}`} class="hover:text-accent transition-colors duration-fast">{cat.name}</a>
          </h3>
          {cat.notes.length > 0 ? (
            <div class="grid gap-4 md:grid-cols-2">
              {cat.notes.slice(0, 4).map((note) => (
                <NoteCard
                  title={note.data.title}
                  description={note.data.description}
                  tags={note.data.tags}
                  date={note.data.date}
                  slug={note.id}
                  source={note.source}
                  feishuUrl={note.data.feishuUrl}
                />
              ))}
            </div>
          ) : (
            <p class="text-sm text-text-muted">暂无笔记，<a href={profile.links.feishuDrive} class="text-accent hover:text-accent-soft" target="_blank" rel="noopener">前往飞书查看 &rarr;</a></p>
          )}
        </div>
      ))}
      <a href={profile.links.feishuDrive} class="btn-tertiary" target="_blank" rel="noopener">在飞书中查看全部笔记 &rarr;</a>
    </section>

    <!-- Recent Projects -->
    <section class="mb-10">
      <h2 class="sec-title">近期成果</h2>
      {projects.length > 0 || ghProjects.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              url={project.data.url}
              repo={project.data.repo}
              date={project.data.date}
              pinned={project.data.pinned}
            />
          ))}
          {ghProjects.map((repo) => (
            <GitHubCard
              title={repo.data.title}
              description={repo.data.description}
              language={repo.data.language}
              stars={repo.data.stars}
              url={repo.data.url}
              updated={repo.data.updated}
            />
          ))}
        </div>
      ) : (
        <p class="text-sm text-text-muted">暂无成果</p>
      )}
      <a href={profile.links.github} class="mt-4 inline-block btn-tertiary" target="_blank" rel="noopener">查看全部成果 &rarr;</a>
    </section>

    <!-- Experience -->
    <section class="mb-10">
      <h2 class="sec-title">工作经历</h2>
      <div class="flex flex-col gap-6">
        {profile.experience.map((exp) => (
          <div>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
              <span class="font-medium text-text">{exp.company} · {exp.role}</span>
              <span class="text-sm text-text-muted">{exp.period}</span>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-text-soft">
              {exp.description}
            </p>
          </div>
        ))}
      </div>
      <a href="/projects" class="mt-4 inline-block btn-tertiary">查看更多经历 &rarr;</a>
    </section>

    <!-- Education -->
    <section class="mb-10">
      <h2 class="sec-title">教育背景</h2>
      <div class="flex flex-col gap-2">
        {profile.education.map((edu) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <span class="font-medium text-text">{edu.school} · {edu.department} · {edu.major}</span>
            <span class="text-sm text-text-muted">{edu.period} · {edu.degree}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="mb-10">
      <h2 class="sec-title">技术能力</h2>
      <div class="flex flex-col gap-4">
        {profile.techStack.map((group) => (
          <div>
            <span class="mb-2 block text-sm font-medium text-text-soft">{group.category}</span>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="tag">{item.name}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certificates -->
    <section class="mb-10">
      <h2 class="sec-title">AI大模型相关证书</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {profile.certificates.map((cert) => (
          <div class="card flex items-center gap-3 p-4">
            <span class="shrink-0 text-accent" aria-hidden="true">✦</span>
            <span class="font-medium text-text">{cert.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section class="mb-10">
      <h2 class="sec-title">联系方式</h2>
      <div class="flex flex-wrap gap-4 text-sm">
        {profile.contact.map((c) => (
          <a href={c.href} class="text-accent hover:text-accent-soft" target={c.type === 'link' ? '_blank' : undefined} rel={c.type === 'link' ? 'noopener' : undefined}>
            {c.label}
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
