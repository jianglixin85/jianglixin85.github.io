---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notesLocal = await getCollection('notes');

  // Only generate pages for local notes; feishu notes redirect to Feishu
  const localPaths = notesLocal.map((note) => ({
    params: { slug: note.id },
    props: { note, source: 'local' },
  }));

  let notesFeishu: typeof notesLocal = [];
  try { notesFeishu = await getCollection('notesFeishu'); } catch {}

  const feishuPaths = notesFeishu.map((note) => ({
    params: { slug: note.id },
    props: { note, source: 'feishu' },
  }));

  return [...localPaths, ...feishuPaths];
}

const { note, source } = Astro.props;

// Feishu docs: redirect to Feishu URL directly
if (source === 'feishu' && note.data.feishuUrl) {
  return Astro.redirect(note.data.feishuUrl);
}

const { Content } = await render(note);
---

<Base title={`${note.data.title} | JLX`} description={note.data.description}>
  <article class="mx-auto max-w-prose px-4 py-12 md:px-6 md:py-16">
    <header class="mb-8">
      <h1 class="text-h1 mb-2">{note.data.title}</h1>
      <div class="flex items-center gap-3 text-sm text-text-muted">
        <time>{note.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      </div>
      <div class="mt-3 flex flex-wrap gap-1">
        {note.data.tags.map((tag: string) => (
          <a
            href={`/notes?tag=${encodeURIComponent(tag)}`}
            class="tag"
          >
            {tag}
          </a>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="mt-12 pt-6">
      <a href="/notes" class="btn-tertiary">&larr; 返回笔记列表</a>
    </footer>
  </article>
</Base>
